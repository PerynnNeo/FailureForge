  "components": {
    "schemas": {
      "CampaignSpec": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1.0",
            "title": "Schema Version",
            "default": "1.0"
          },
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name",
            "default": "Visual robustness campaign"
          },
          "backend": {
            "type": "string",
            "enum": [
              "synthetic",
              "libero"
            ],
            "title": "Backend",
            "default": "libero"
          },
          "method": {
            "type": "string",
            "enum": [
              "random",
              "sobol",
              "sobol_local_mix"
            ],
            "title": "Method",
            "default": "sobol_local_mix"
          },
          "candidate_count": {
            "type": "integer",
            "enum": [
              8,
              16,
              32
            ],
            "title": "Candidate Count",
            "default": 32
          },
          "seed": {
            "type": "integer",
            "maximum": 2147483647.0,
            "minimum": 0.0,
            "title": "Seed",
            "default": 1729
          },
          "domain": {
            "$ref": "#/components/schemas/Domain"
          },
          "state_ids": {
            "items": {
              "type": "integer",
              "maximum": 9999.0,
              "minimum": 0.0
            },
            "type": "array",
            "maxItems": 2,
            "minItems": 2,
            "title": "State Ids"
          },
          "confirmation_state_ids": {
            "items": {
              "type": "integer",
              "maximum": 9999.0,
              "minimum": 0.0
            },
            "type": "array",
            "maxItems": 10,
            "minItems": 10,
            "title": "Confirmation State Ids"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "CampaignSpec"
      },
      "Domain": {
        "properties": {
          "main_camera_dx_m": {
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array",
            "maxItems": 2,
            "minItems": 2,
            "title": "Main Camera Dx M",
            "default": [
              -0.04,
              0.04
            ]
          },
          "light_scale": {
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array",
            "maxItems": 2,
            "minItems": 2,
            "title": "Light Scale",
            "default": [
              0.7,
              1.3
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Domain"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Parameter": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name"
          },
          "value": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1,
            "title": "Value"
          },
          "unit": {
            "type": "string",
            "maxLength": 50,
            "title": "Unit",
            "default": ""
          },
          "source": {
            "type": "string",
            "enum": [
              "imported",
              "supplier",
              "estimated",
              "measured",
              "calibrated"
            ],
            "title": "Source"
          },
          "range_min": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Range Min"
          },
          "range_max": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Range Max"
          },
          "evidence": {
            "type": "string",
            "maxLength": 1000,
            "title": "Evidence",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "value",
          "source"
        ],
        "title": "Parameter"
      },
      "ProjectSpec": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Name"
          },
          "entry_stage": {
            "type": "string",
